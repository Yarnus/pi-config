{
  "theme": "paper-light/paper-dark",
  "tuiMode": "fullscreen",
  "editorPaddingX": 2,
  "terminal": {
    "showImages": true,
    "images": "kitty",
    "imageWidthCells": 120
  },
  "packages": [
    "npm:pi-subagents@0.65.0",
    "npm:pi-web-access@0.29.0",
    "npm:@juicesharp/rpiv-todo@2.10.1",
    "npm:@narumitw/pi-btw@0.59.0",
    "npm:pi-permissive@0.3.3",
    "npm:pi-elixir@0.8.5"
  ],
  "skills": [
    "!**/.agents/skills/**"
  ],
  "subagents": {
    "agentOverrides": {
      "scout": {
        "model": "openai-codex/gpt-6-luna",
        "thinking": "max"
      },
      "plan-executor": {
        "model": "openai-codex/gpt-6-luna",
        "thinking": "max"
      }
    }
  },
  "defaultProvider": "openai-codex",
  "defaultModel": "gpt-6-sol",
  "lastChangelogVersion": "0.87.1",
  "enabledModels": [
    "openai-codex/gpt-5.6-luna",
    "openai-codex/gpt-5.6-sol",
    "openai-codex/gpt-6-astra",
    "openai-codex/gpt-6-luna",
    "openai-codex/gpt-6-sol"
  ]
}