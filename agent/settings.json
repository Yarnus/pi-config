{
  "theme": "paper-light/paper-dark",
  "tuiMode": "fullscreen",
  "editorPaddingX": 2,
  "terminal": {
    "showImages": true,
    "images": "kitty",
    "imageWidthCells": 120
  },
  "packages": [
    "npm:pi-subagents@0.65.0",
    "npm:pi-web-access@0.29.0",
    "npm:@juicesharp/rpiv-todo@2.10.1",
    "npm:@narumitw/pi-btw@0.59.0",
    "npm:pi-permissive@0.3.3"
  ],
  "skills": ["!**/.agents/skills/**"],
  "subagents": {
    "agentOverrides": {
      "scout": {
        "model": "chrono/gpt-5.6-luna",
        "thinking": "max"
      },
      "plan-executor": {
        "model": "chrono/gpt-5.6-luna",
        "thinking": "max"
      }
    }
  },
  "defaultProvider": "chrono",
  "defaultModel": "gpt-6-astra",
  "lastChangelogVersion": "0.85.1"
}
